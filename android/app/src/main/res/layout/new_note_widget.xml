<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed-size circle centered in the cell: the cell is rarely square, so a
     match_parent oval would be stretched into an ellipse. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_circle_background">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_widget_note"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/widget_note"
            android:textSize="10sp"
            android:textColor="#FF1E1E1E"
            android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
